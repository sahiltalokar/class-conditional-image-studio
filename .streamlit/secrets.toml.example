# Streamlit Secrets Template for Class-Conditional Image Studio
# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, enter these key-value pairs in the App Settings > Secrets dashboard.
# NEVER commit secrets.toml to GitHub!

GROQ_API_KEY = "YOUR_GROQ_API_KEY"
GROQ_MODEL = "openai/gpt-oss-20b"
